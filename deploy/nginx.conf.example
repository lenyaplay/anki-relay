# Anki Relay behind your own nginx (COMPOSE_PROFILES empty in .env).
# Copy to /etc/nginx/sites-available/anki-relay, adjust server_name and the
# certificate paths (e.g. from certbot), enable it and reload nginx.

server {
    listen 80;
    listen [::]:80;
    server_name anki-relay.example.com;
    # Let certbot answer its challenge here, send everything else to HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name anki-relay.example.com;

    ssl_certificate     /etc/letsencrypt/live/anki-relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/anki-relay.example.com/privkey.pem;

    # add_media accepts files up to MEDIA_MAX_MB (default 100 MB) as base64,
    # which is ~4/3 larger. Keep this above MEDIA_MAX_MB * 1.4.
    client_max_body_size 150m;

    location / {
        # Must match APP_PORT in .env (and BIND_ADDRESS must be reachable from
        # nginx: the default 127.0.0.1 works when nginx runs on the same host).
        proxy_pass http://127.0.0.1:8000;

        # The app checks the Host header against PUBLIC_URL (DNS rebinding
        # protection), so pass the original host through.
        proxy_set_header Host $host;

        # Real client IP for the sign-in rate limit. The app trusts this header
        # only from addresses in TRUSTED_PROXIES (default: 127.0.0.1 and the
        # Docker networks, which covers nginx on the same host).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MCP uses streaming HTTP responses (Server-Sent Events). Without these
        # three lines nginx buffers or cuts them off and Claude's requests hang.
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
