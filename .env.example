# Anki Relay configuration. Copy to .env and fill in the two required values.
# Everything else is optional: by default every feature is enabled, and the
# settings below only restrict features or relax protections.

# ---------------------------------------------------------------- required

# External address of the server, without /mcp. Must be https:// (http:// only
# for localhost / 127.0.0.1 during development).
PUBLIC_URL=https://anki-relay.example.com

# AnkiWeb email addresses allowed to sign in, comma-separated. Only add people
# you trust: the server admin technically has access to their collections.
ALLOWED_EMAILS=me@example.com,friend@example.com

# ---------------------------------------------------------------- deployment mode

# Built-in HTTPS with Caddy (ports 80 and 443 must be open):
#   COMPOSE_PROFILES=caddy
# Your own nginx (see deploy/nginx.conf.example): an empty value, nothing after "=":
#   COMPOSE_PROFILES=
# (Deleting the line works the same. A COMPOSE_PROFILES variable exported in your
# shell overrides this file, so check `echo $COMPOSE_PROFILES` if Caddy starts anyway.)
COMPOSE_PROFILES=caddy

# Host address the app port is published on. 127.0.0.1 = only this machine
# (nginx on the same VPS); 0.0.0.0 = all interfaces (then firewall the port
# and add your proxy's address to TRUSTED_PROXIES).
# BIND_ADDRESS=127.0.0.1
# App port on the host (what proxy_pass points to).
# APP_PORT=8000
# Caddy ports on the host (caddy mode only). Non-standard ports break the usual
# Let's Encrypt validation; see the README.
# HTTP_PORT=80
# HTTPS_PORT=443

# ---------------------------------------------------------------- tools

# Tools that should not be registered at all, comma-separated, e.g.
# DISABLED_TOOLS=delete_notes,delete_deck,delete_note_type,forget_cards
# DISABLED_TOOLS=
# Allow restructuring note types (fields/templates of existing types, deleting
# types, changing note types). Requires one-way uploads to AnkiWeb by protocol.
# ALLOW_SCHEMA_CHANGES=true
# Maximum items per batch call.
# MAX_BATCH=500

# ---------------------------------------------------------------- media

# Sync media files with AnkiWeb (two-way: the first run downloads ALL of the
# user's media, possibly gigabytes). false also disables add_media.
# MEDIA_SYNC=true
# Allowed file extensions, or * for any file.
# MEDIA_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,svg,avif,bmp,tif,tiff,ico,mp3,ogg,oga,opus,wav,flac,m4a,aac,mp4,webm,mkv,mov
# Size limit per file, in MB.
# MEDIA_MAX_MB=100
# Download timeout for add_media(url=...), in seconds.
# MEDIA_DOWNLOAD_TIMEOUT=60
# Allow downloads from private/internal addresses (NAS, other services on your
# network). Off by default to prevent SSRF; see the README before enabling.
# MEDIA_ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------- sync

# Don't pull from AnkiWeb more often than every N seconds.
# SYNC_PULL_INTERVAL=60
# Push accumulated changes after N seconds without new changes...
# SYNC_PUSH_DELAY=10
# ...but no later than N seconds after the first unsynced change.
# SYNC_PUSH_MAX_DELAY=60
# Backups of a user's collection kept before schema changes / full downloads.
# BACKUP_KEEP=10
# Self-hosted Anki sync server instead of AnkiWeb (empty = AnkiWeb).
# SYNC_ENDPOINT=

# ---------------------------------------------------------------- sign-in & tokens

# Access token lifetime, seconds.
# ACCESS_TOKEN_TTL=3600
# Days without use after which users have to sign in again.
# REFRESH_TOKEN_TTL_DAYS=90
# Failed sign-ins per IP within LOGIN_FAIL_WINDOW before that IP is blocked
# (plus a global limit of 5x this number).
# LOGIN_MAX_FAILS=10
# LOGIN_FAIL_WINDOW=900
# Sign-in page language: auto (from the browser), ru or en.
# DEFAULT_LANGUAGE=auto
# Proxies whose X-Forwarded-For header is trusted (IPs or networks).
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# ---------------------------------------------------------------- runtime

# Close a user's collection after N idle minutes.
# COLLECTION_IDLE_MINUTES=30
# Where the app listens inside the container (change only when running without Docker).
# HOST=0.0.0.0
# PORT=8000
# DATA_DIR=/data
# DEBUG, INFO, WARNING, ERROR. Passwords, tokens, emails and card contents are never logged.
# LOG_LEVEL=INFO
# JSON log files inside the container (mounted to ./logs on the host). Empty = stdout only.
# LOG_DIR=/logs
# Days of log files to keep (one file per day).
# LOG_RETENTION_DAYS=14
